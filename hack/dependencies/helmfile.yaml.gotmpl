---
repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: kedacore
    url: https://kedacore.github.io/charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  - name: seaweedfs
    url: https://seaweedfs.github.io/seaweedfs/helm

releases:
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.16.2
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - crds:
          enabled: true

  # Envoy Gateway provides the Gateway API data plane and activation metrics.
  - name: envoy-gateway
    namespace: envoy-gateway-system
    chart: oci://docker.io/envoyproxy/gateway-helm
    version: v1.8.2
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - config:
          envoyGateway:
            extensionApis:
              disableLua: false
    hooks:
      # Apply Gateway resources after their CRDs are installed. Server-side
      # admission still validates resources when client validation is disabled.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - apply
          - --validate=false
          - -f
          - gateway.yaml

  - name: opentelemetry-operator
    namespace: opentelemetry-operator-system
    chart: open-telemetry/opentelemetry-operator
    version: 0.101.0
    createNamespace: true
    wait: true
    timeout: 600
    needs:
      - cert-manager/cert-manager
    values:
      - manager:
          collectorImage:
            repository: otel/opentelemetry-collector-k8s

  - name: keda
    namespace: keda
    chart: kedacore/keda
    version: 2.18.1
    createNamespace: true
    wait: true
    timeout: 600

  - name: kedify-otel
    namespace: keda
    chart: oci://ghcr.io/kedify/charts/otel-add-on
    version: v0.0.6
    createNamespace: false
    wait: true
    timeout: 600
    needs:
      - keda/keda
    values:
      - validatingAdmissionPolicy:
          enabled: false

  - name: kserve-crd
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-crd
    version: v0.20.0
    createNamespace: true
    wait: true
    timeout: 600
    needs:
      - keda/kedify-otel

  # The release keeps its pre-v0.17 name so existing clusters upgrade in place
  # instead of hitting Helm ownership conflicts on the same objects.
  - name: kserve
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-resources
    version: v0.20.0
    createNamespace: false
    wait: true
    waitForJobs: true
    disableValidation: true
    timeout: 600
    needs:
      - kserve-system/kserve-crd
      - cert-manager/cert-manager
    values:
      - kserve:
          controller:
            deploymentMode: Standard
            gateway:
              ingressGateway:
                enableGatewayApi: false
          localmodel:
            enabled: false
          # Remove default resource limits/requests for inference services
          # Let workloads set their own resources as needed
          # See: helm show values oci://ghcr.io/kserve/charts/kserve-resources
          inferenceservice:
            resources:
              limits:
                cpu: ""
                memory: ""
              requests:
                cpu: ""
                memory: ""

  # LLMInferenceService runs in the "kserve" namespace, separate from the
  # InferenceService stack: the LLM CRD conversion webhook and the preset
  # LLMInferenceServiceConfigs are hardcoded to that namespace, and the LLM
  # controller only reads presets from its own namespace.
  - name: kserve-llmisvc-crd
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-llmisvc-crd
    version: v0.20.0
    createNamespace: true
    wait: true
    timeout: 600
    needs:
      # Both CRD charts ship the ClusterStorageContainer CRD and skip it only
      # when another release already owns it, so they must not run in parallel.
      - kserve-system/kserve-crd

  - name: kserve-llmisvc-resources
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-llmisvc-resources
    version: v0.20.0
    createNamespace: false
    wait: true
    timeout: 600
    needs:
      - kserve/kserve-llmisvc-crd
      - cert-manager/cert-manager
      # The controller only watches HTTPRoutes and Gateways if the Gateway API
      # CRDs (installed by Envoy Gateway) exist when it starts.
      - envoy-gateway-system/envoy-gateway
    values:
      - kserve:
          # The cluster-scoped default ClusterStorageContainer belongs to the
          # kserve release; this namespace still needs its own
          # inferenceservice-config and webhook certificate issuer.
          createSharedResources: false
          inferenceServiceConfig:
            enabled: true
          certManager:
            enabled: true
          controller:
            gateway:
              ingressGateway:
                kserveGateway: envoy-gateway-system/kserve-ingress-gateway

  - name: kserve-runtime-configs
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-runtime-configs
    version: v0.20.0
    createNamespace: false
    wait: true
    timeout: 600
    needs:
      - kserve/kserve-llmisvc-resources
    values:
      - kserve:
          llmisvcConfigs:
            enabled: true
    hooks:
      # The LLMInferenceServiceConfig presets are admitted by a fail-closed
      # webhook, which needs ready endpoints and an injected CA bundle.
      - events: ["presync"]
        showlogs: true
        command: kubectl
        args:
          - wait
          - --namespace=kserve
          - --for=jsonpath={.subsets[0].addresses}
          - endpoints/llmisvc-webhook-server-service
          - --timeout=180s
      - events: ["presync"]
        showlogs: true
        command: kubectl
        args:
          - wait
          - --for=jsonpath={.webhooks[0].clientConfig.caBundle}
          - validatingwebhookconfiguration/llminferenceserviceconfig.serving.kserve.io
          - --timeout=180s

  - name: seaweedfs
    namespace: seaweedfs-system
    chart: seaweedfs/seaweedfs
    version: 4.19.0
    createNamespace: true
    wait: true
    timeout: 300
    values:
      - master:
          replicas: 1
          affinity: ""
          data:
            type: emptyDir
        volume:
          replicas: 1
          affinity: ""
          data:
            type: emptyDir
        filer:
          replicas: 1
          affinity: ""
          s3:
            enabled: true
            enableAuth: false
          data:
            type: emptyDir